{
	"name": "n8n-nodes-fox-schema-sql-builder",
	"version": "0.2.2",
	"description": "Multi-dialect SQL Builder for n8n powered by FoxSchema (Postgres, CockroachDB, YugabyteDB, Redshift, MySQL/MariaDB, TiDB, SQL Server, Azure SQL, Oracle, SQLite, DuckDB, ClickHouse). Db2 is not supported.",
	"keywords": [
		"n8n-community-node-package",
		"n8n-community-node",
		"foxschema",
		"sql",
		"sqlbuilder",
		"postgres",
		"mysql",
		"sqlserver",
		"oracle",
		"sqlite",
		"clickhouse",
		"duckdb",
		"redshift",
		"cockroachdb",
		"tidb",
		"workflow"
	],
	"license": "MIT",
	"author": {
		"name": "Huy Phan",
		"email": "huyplb@live.com"
	},
	"homepage": "https://foxschema.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/tedious-code/n8n-nodes-fox-schema-sql-builder.git"
	},
	"engines": {
		"node": ">=20 <=24",
		"pnpm": ">=9.1"
	},
	"packageManager": "pnpm@10.23.0",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"bundle:foxschema": "node scripts/bundle-foxschema.mjs",
		"build": "pnpm run bundle:foxschema && tsc && node scripts/copy-assets.mjs",
		"dev": "tsc --watch",
		"test": "tsc --noEmit && node --import tsx --test test/*.test.ts",
		"test:e2e": "pnpm build && node --import tsx --test test/e2e/**/*.e2e.test.ts",
		"seed:foxschema": "bash scripts/seed-from-foxschema.sh",
		"pack:n8n": "bash scripts/pack-for-n8n.sh",
		"test:n8n": "bash scripts/test-in-n8n-db2.sh",
		"validate:n8n": "node scripts/validate-n8n-package.mjs",
		"scan:n8n": "node scripts/scan-n8n-local.mjs"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/FoxSchemaDbCredentialsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FoxSchemaSqlBuilder/FoxSchemaSqlBuilder.node.js"
		]
	},
	"dependencies": {},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/scan-community-package": "beta",
		"@clickhouse/client": "^1.23.1",
		"@duckdb/node-api": "1.5.5-r.4",
		"@types/node": "^20.11.30",
		"better-sqlite3": "^13.0.3",
		"esbuild": "^0.25.0",
		"mssql": "^12.7.0",
		"mysql2": "^3.24.3",
		"n8n-workflow": "^2.0.1",
		"oracledb": "^7.0.1",
		"pg": "^8.23.0",
		"tsx": "^4.23.1",
		"typescript": "^5.4.5"
	}
}
